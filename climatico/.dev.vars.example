# Copy to .dev.vars (gitignored). Generate TOKEN_SECRET with: openssl rand -hex 32
TOKEN_SECRET=replace-with-openssl-rand-hex-32

# Google Gemini API key for agentic analysis, clerk chat, and search grounding
GEMINI_API_KEY=replace-with-your-gemini-api-key

